# کپی کن به نام .env و مقادیر را متناسب با محیط خودت تنظیم کن
# cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=price_monitor
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=price_monitor

# اگر بک‌اند را بیرون از Docker اجرا می‌کنی (مثلا هنگام توسعه) این مقدار استفاده می‌شود.
# داخل docker-compose این متغیر خودکار بازنویسی می‌شود تا به سرویس db اشاره کند.
DATABASE_URL=postgresql+psycopg2://price_monitor:change_this_password@localhost:5432/price_monitor

# ---------- Scheduler ----------
CHECK_INTERVAL=3600
SCRAPER_CONCURRENCY=3
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_USE_PLAYWRIGHT_FALLBACK=true

# ---------- Telegram ----------
# ربات بساز: با @BotFather در تلگرام گفتگو کن، دستور /newbot را بزن و توکن را اینجا بگذار.
# CHAT_ID: با @userinfobot یا @get_id_bot چت آیدی خودت یا گروهت را بگیر.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_THRESHOLD_PERCENT=10

# ---------- API / CORS ----------
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# ---------- Excel Import ----------
EXCEL_IMPORT_PATH=/app/database/inventory.xlsx

# ---------- Frontend (build-time) ----------
# آدرس عمومی بک‌اند که مرورگر کاربر باید به آن وصل شود.
VITE_API_URL=http://localhost:8000
